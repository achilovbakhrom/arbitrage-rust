# Binance SBE market-data and REST/FIX configuration
TAA_SBE_API_KEY=your_binance_api_key
TAA_FIX_API=your_binance_api_key

# Trading mode
# false: detect and log only
# true with TAA_DEBUG=true: mock FIX execution
# true with TAA_DEBUG=false: real FIX execution
TAA_ENABLE_TRADING=false
TAA_DEBUG=true

# Strategy settings
TAA_BASE_ASSET=USDT
TAA_EXCLUDED_COINS=USD,EUR,GBP,JPY,AUD,CAD,CHF,CNY,RUB,TRY
TAA_MAX_TRIANGLES=15
TAA_THRESHOLD=0.002
TAA_TRADE_AMOUNT=100
TAA_FEE=0.001
TAA_DEPTH=5
TAA_MIN_VOLUME_MULTIPLIER=2.0

# Real FIX execution settings
TAA_FIX_PRIVATE_KEY_BASE64=
TAA_FIX_TARGET_COMP_ID=SPOT
TAA_FIX_HEARTBEAT_INTERVAL=30
TAA_FIX_ENDPOINT=fix-oe.binance.com:9000

# Optional order status credentials for real execution
TAA_API_KEY=
TAA_API_SECRET=

# Execution safety and performance settings
TAA_MAX_SLIPPAGE_PERCENTAGE=0.5
TAA_MIN_EXECUTION_PROFIT_THRESHOLD=0.1
TAA_PERFORMANCE_TEST_DURATION=300

# Logging
TAA_LOG_LEVEL=info
TAA_LOG_DIRECTORY=logs
TAA_LOG_FILENAME_PREFIX=triangular_arbitrage
TAA_LOG_ROTATION=daily
TAA_LOG_MAX_FILES=10
